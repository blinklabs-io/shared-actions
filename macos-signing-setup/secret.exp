set timeout 60
foreach name {SECRET_INPUT SECRET_ACTION SECRET_KEYCHAIN} {
    if {![info exists env($name)]} {
        puts stderr "$name is required"
        exit 1
    }
}
set secret $env(SECRET_INPUT)
set action $env(SECRET_ACTION)
set keychain $env(SECRET_KEYCHAIN)
unset env(SECRET_INPUT)
set supplied 0
log_user 0
switch -- $action {
    create {
        spawn -noecho security create-keychain $keychain
    }
    unlock {
        spawn -noecho security unlock-keychain $keychain
    }
    partition {
        spawn -noecho security set-key-partition-list -S apple-tool:,apple:,codesign:,productsign: -s $keychain
    }
    notary {
        foreach name {SECRET_PROFILE NOTARY_APPLE_ID NOTARY_TEAM_ID} {
            if {![info exists env($name)]} {
                puts stderr "$name is required"
                exit 1
            }
        }
        spawn -noecho xcrun notarytool store-credentials $env(SECRET_PROFILE) --apple-id $env(NOTARY_APPLE_ID) --team-id $env(NOTARY_TEAM_ID) --keychain $keychain
    }
    default {
        puts stderr "unsupported secret command"
        exit 1
    }
}
expect {
    -re {(?i)(password|passphrase)[^:\r\n]*:} {
        set supplied 1
        send -- "$secret\r"
        exp_continue
    }
    eof {}
    timeout {
        puts stderr "$action timed out waiting for a secret prompt"
        exit 1
    }
}
if {!$supplied} {
    puts stderr "$action did not request its secret"
    exit 1
}
set result [wait]
if {[lindex $result 2] != 0} {
    puts stderr "$action could not be started"
    exit 1
}
set exit_code [lindex $result 3]
if {$exit_code != 0} {
    puts stderr "$action failed with exit status $exit_code"
}
exit $exit_code
